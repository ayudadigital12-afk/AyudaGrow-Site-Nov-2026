RewriteCond %{HTTPS} !=on
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]
# Do not expose host configuration or the fallback-host rule files.
RewriteRule ^(?:\.htaccess|_(?:headers|redirects)|route-manifest\.json|source(?:/|$)|scripts(?:/|$)|docs(?:/|$)|deploy(?:/|$)|build(?:/|$)|checks(?:/|$)|node_modules(?:/|$)|\.git(?:/|$)|package(?:-lock)?\.json|README\.md|HOSTING\.md) - [R=404,L]
RewriteRule ^signup/essentials$ dist/signup/essentials/index.html [END]
