RewriteRule ^platform/lead-capture(?:/|/index\.html)?$ https://%{HTTP_HOST}/lead-capture [R=301,L]
RewriteRule ^platform/appointments(?:/|/index\.html)?$ https://%{HTTP_HOST}/appointments [R=301,L]
RewriteRule ^platform/reputation-reviews(?:/|/index\.html)?$ https://%{HTTP_HOST}/reputation [R=301,L]
RewriteRule ^platform/reporting-forecasting(?:/|/index\.html)?$ https://%{HTTP_HOST}/reporting [R=301,L]
RewriteRule ^who-its-for(?:/|/index\.html)?$ https://%{HTTP_HOST}/use-cases [R=301,L]
RewriteRule ^who-its-for/b2b(?:/|/index\.html)?$ https://%{HTTP_HOST}/consultative-sales [R=301,L]
RewriteRule ^who-its-for/b2c(?:/|/index\.html)?$ https://%{HTTP_HOST}/appointments [R=301,L]
RewriteRule ^how-it-works(?:/|/index\.html)?$ https://%{HTTP_HOST}/support [R=301,L]
RewriteRule ^free-trial(?:/|/index\.html)?$ https://%{HTTP_HOST}/signup/essentials [R=301,L]
RewriteRule ^get-started(?:/|/index\.html)?$ https://%{HTTP_HOST}/pricing [R=301,L]
RewriteRule ^book(?:/|/index\.html)?$ https://%{HTTP_HOST}/contact [R=301,L]
RewriteRule ^index\.html$ https://%{HTTP_HOST}/ [R=301,L]
RewriteRule ^signup/essentials(?:/|/index\.html)$ https://%{HTTP_HOST}/signup/essentials [R=301,L]
RewriteRule ^signup/core(?:/|/index\.html)$ https://%{HTTP_HOST}/signup/core [R=301,L]
