# STAGING ONLY: retain noindex.
Options -Indexes -MultiViews
DirectoryIndex index.html
DirectorySlash Off
ErrorDocument 404 /dist/404.html
<IfModule mod_headers.c>
  Header always set X-Robots-Tag "noindex, nofollow"
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Content-Security-Policy "upgrade-insecure-requests; base-uri 'self'; object-src 'none'; frame-ancestors 'self'"
  Header always set Permissions-Policy "camera=(), geolocation=(), browsing-topics=(), microphone=(self)"
  <FilesMatch "\.(?:html|xml|txt|json)$">
    Header set Cache-Control "no-cache, max-age=0, must-revalidate"
  </FilesMatch>
  <FilesMatch "\.(?:css|js|webp|png|jpg|svg|woff2)$">
    Header set Cache-Control "public, max-age=3600, must-revalidate"
  </FilesMatch>
  # A year of caching is safe only for genuinely content-fingerprinted filenames.
  <FilesMatch "\.[a-f0-9]{12}\.(?:css|js|webp|png|jpg|svg|woff2)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css application/javascript application/json application/xml text/xml image/svg+xml
</IfModule>
<IfModule mod_passenger.c>
  PassengerEnabled off
</IfModule>
RewriteEngine On
RewriteRule ^dist/404\.html$ - [END]
# Redirect direct build-directory route aliases.
RewriteRule ^dist/signup/essentials/?$ https://%{HTTP_HOST}/signup/essentials [R=301,L]
RewriteRule ^dist/signup/core/?$ https://%{HTTP_HOST}/signup/core [R=301,L]
RewriteRule ^dist/signup/build/?$ https://%{HTTP_HOST}/signup/build [R=301,L]
RewriteRule ^dist/signup/scale/?$ https://%{HTTP_HOST}/signup/scale [R=301,L]
RewriteRule ^dist/platform/?$ https://%{HTTP_HOST}/platform [R=301,L]
RewriteRule ^dist/solutions/?$ https://%{HTTP_HOST}/solutions [R=301,L]
RewriteRule ^dist/inbox/?$ https://%{HTTP_HOST}/inbox [R=301,L]
RewriteRule ^dist/ai/?$ https://%{HTTP_HOST}/ai [R=301,L]
RewriteRule ^dist/crm/?$ https://%{HTTP_HOST}/crm [R=301,L]
RewriteRule ^dist/appointments/?$ https://%{HTTP_HOST}/appointments [R=301,L]
RewriteRule ^dist/consultative-sales/?$ https://%{HTTP_HOST}/consultative-sales [R=301,L]
RewriteRule ^dist/use-cases/?$ https://%{HTTP_HOST}/use-cases [R=301,L]
RewriteRule ^dist/lead-capture/?$ https://%{HTTP_HOST}/lead-capture [R=301,L]
RewriteRule ^dist/follow-up/?$ https://%{HTTP_HOST}/follow-up [R=301,L]
RewriteRule ^dist/reactivation/?$ https://%{HTTP_HOST}/reactivation [R=301,L]
