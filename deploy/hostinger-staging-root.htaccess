RewriteCond %{HTTPS} !=on
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]
# Do not expose host configuration or the fallback-host rule files.
RewriteRule ^(?:\.htaccess|_(?:headers|redirects))$ - [R=404,L]
RewriteRule ^platform$ release-20261110/platform/index.html [END]
RewriteRule ^solutions$ release-20261110/solutions/index.html [END]
