RewriteRule ^(?:\.|source(?:/|$)|scripts(?:/|$)|checks(?:/|$)|node_modules(?:/|$)|dist(?:/|$)|deploy(?:/|$)) - [R=404,L]
RewriteCond %{DOCUMENT_ROOT}/dist/$1 -f
RewriteRule ^(.+)$ dist/$1 [END]
RewriteRule ^ - [R=404,L]
