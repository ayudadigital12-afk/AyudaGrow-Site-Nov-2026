RewriteRule ^dist/marketing/?$ https://%{HTTP_HOST}/marketing [R=301,L]
RewriteRule ^dist/commerce/?$ https://%{HTTP_HOST}/commerce [R=301,L]
RewriteRule ^dist/learning/?$ https://%{HTTP_HOST}/learning [R=301,L]
RewriteRule ^dist/support/?$ https://%{HTTP_HOST}/support [R=301,L]
RewriteRule ^dist/pricing/?$ https://%{HTTP_HOST}/pricing [R=301,L]
RewriteRule ^dist/privacy/?$ https://%{HTTP_HOST}/privacy [R=301,L]
RewriteRule ^dist/cookies/?$ https://%{HTTP_HOST}/cookies [R=301,L]
RewriteRule ^dist/contact/?$ https://%{HTTP_HOST}/contact [R=301,L]
RewriteRule ^dist/growth-assessment/?$ https://%{HTTP_HOST}/growth-assessment [R=301,L]
RewriteRule ^dist/learn/?$ https://%{HTTP_HOST}/learn [R=301,L]
RewriteRule ^dist/solutions/book-more-appointments/?$ https://%{HTTP_HOST}/solutions/book-more-appointments [R=301,L]
RewriteRule ^dist/solutions/convert-more-leads/?$ https://%{HTTP_HOST}/solutions/convert-more-leads [R=301,L]
RewriteRule ^dist/solutions/generate-more-reviews/?$ https://%{HTTP_HOST}/solutions/generate-more-reviews [R=301,L]
RewriteRule ^dist/solutions/improve-customer-communication/?$ https://%{HTTP_HOST}/solutions/improve-customer-communication [R=301,L]
RewriteRule ^dist/solutions/improve-sales-follow-up/?$ https://%{HTTP_HOST}/solutions/improve-sales-follow-up [R=301,L]
RewriteRule ^dist/solutions/manage-sales-opportunities/?$ https://%{HTTP_HOST}/solutions/manage-sales-opportunities [R=301,L]
RewriteRule ^dist/solutions/reactivate-customers/?$ https://%{HTTP_HOST}/solutions/reactivate-customers [R=301,L]
# Hide build-directory URLs from visitors.
RewriteCond %{THE_REQUEST} [[:space:]]/+dist(?:/|[[:space:]?]) [NC]
RewriteRule ^dist(?:/(.*))?$ /$1 [R=301,L]
# User-confirmed staff and customer login. Fixed destination; query retained.
RewriteRule ^login(?:/|/index\.html)?$ https://app.ayudagrow.com/ [R=301,L]
# Normalise direct build-directory requests at the served-directory level too.
RewriteCond %{THE_REQUEST} \s/+dist/([^\s?]*) [NC]
RewriteRule ^ https://%{HTTP_HOST}/%1 [R=301,L]
# Resolve legacy and slash/index variants directly to an HTTPS final path; preserve the query.
RewriteRule ^platform/unified-conversations(?:/|/index\.html)?$ https://%{HTTP_HOST}/inbox [R=301,L]
RewriteRule ^platform/follow-up-automation(?:/|/index\.html)?$ https://%{HTTP_HOST}/follow-up [R=301,L]
